# Plenum — environment variables (names only; never commit real values)

# Monad testnet (chain 10143). Never point any of these at mainnet.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_VERIFIER_URL=https://sourcify-api-monad.blockvision.org/
DEPLOYER_PRIVATE_KEY=
FALLBACK_NAV_WRITER_KEY=          # labelled FALLBACK; demo resilience only

# AI manager (Qwen 3.8 Max via Alibaba Cloud Model Studio, OpenAI-compatible, Singapore region).
# Base URL is workspace-specific per current Model Studio docs; confirm when the key arrives.
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
QWEN_BASE_URL=https://${QWEN_WORKSPACE_ID}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
MANAGER_OPERATOR_KEY=             # scoped to ManagerGateway only; holds no user funds
MANAGER_ENC_SEED=                 # 32-byte hex; manager's data-room key (print its public key: pnpm --filter @plenum/agent manager-key)
PLENUM_ADDRESS=                   # the plenum this manager runs
BLOB_API_URL=                     # the app's data-room API, e.g. https://<app>/api/blobs

# Cleanverse sandbox (details from community repos; confirm with Cleanverse). MOCK used until go/no-go.
CLEANVERSE_API_BASE=
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=

# Chainlink CRE (forwarders from the CRE forwarder directory, chain name monad-testnet)
CRE_API_KEY=
CRE_FORWARDER_MONAD_TESTNET_MOCK=0xB9F79d863261869B234c481D1f9A7af84AeAd192   # `cre workflow simulate --broadcast`
CRE_FORWARDER_MONAD_TESTNET=0xF8344CFd5c43616a4366C34E3EEE75af79a74482        # deployed workflows

# Envio (HyperSync for Monad testnet: https://10143.hypersync.xyz)
ENVIO_API_TOKEN=

# Data room storage: Cloudflare R2 (ciphertext only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# App (public, baked into the Next.js build)
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_INDEXER_URL=          # Envio GraphQL endpoint
NEXT_PUBLIC_MANAGER_ADDRESS=      # address of MANAGER_OPERATOR_KEY
NEXT_PUBLIC_MANAGER_ENC_PUBKEY=   # output of `pnpm --filter @plenum/agent manager-key`
